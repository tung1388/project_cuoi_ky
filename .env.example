# Personal access token with `contents:write` on GITHUB_REPO.
GITHUB_TOKEN=

# e.g. GITHUB_OWNER=tung1883, GITHUB_REPO=githost-blobs
GITHUB_OWNER=
GITHUB_REPO=

# Per-folder AES-256 keys, "folder:key,folder:key,...". Each key is any
# string (padded/truncated to 32 bytes). Whoever holds a folder's key can
# decrypt everything under blobs/<folder>/ - admin's own .env would list
# every folder's key; a friend's .env should list only their own.
# Example: ENCRYPTION_KEYS=admin:tung1883,quantran:quantran
ENCRYPTION_KEYS=
